#![enable(implicit_some)]
#![enable(unwrap_newtypes)]
#![enable(unwrap_variant_newtypes)]
(
    default_album_art_path: None,
    format_tag_separator: " | ",
    browser_column_widths: [20, 38, 42],
    background_color: "#0d001d",
    text_color: "#ffce88",
    header_background_color: "#0d001d",
    modal_background_color: "#0d001d",
    modal_backdrop: false,
    preview_label_style: (fg: "#eaa000"),
    preview_metadata_group_style: (fg: "#eaa000", modifiers: "Bold"),
    highlighted_item_style: (fg: "#001608", bg: "#be8100", modifiers: "Bold"),
    current_item_style: (fg: "#001608", bg: "#dfa039", modifiers: "Bold"),
    borders_style: (fg: "#8c5f00"),
    highlight_border_style: (fg: "#8c5f00"),
    symbols: (
        song: "S",
        dir: "D",
        playlist: "P",
        marker: "M",
        ellipsis: "...",
        song_style: None,
        dir_style: None,
        playlist_style: None,
    ),
    level_styles: (
        info: (fg: "#32c978", bg: "#0d001d"),
        warn: (fg: "yellow", bg: "#0d001d"),
        error: (fg: "red", bg: "#0d001d"),
        debug: (fg: "light_green", bg: "#0d001d"),
        trace: (fg: "magenta", bg: "#0d001d"),
    ),
    progress_bar: (
        symbols: ["█", "█", "█", " ", "█"],
        track_style: (fg: "#8c5f00", bg: "#0d001d"),
        elapsed_style: (fg: "#be8100", bg: "#0d001d"),
        thumb_style: (fg: "#8c5f00", bg: "#0d001d"),
        use_track_when_empty: true,
    ),
    scrollbar: (
        symbols: ["│", "█", "▲", "▼"],
        track_style: (fg: "#8c5f00", bg: "#0d001d"),
        ends_style: (fg: "#8c5f00", bg: "#0d001d"),
        thumb_style: (fg: "#8c5f00", bg: "#0d001d"),
    ),
    tab_bar: (
        active_style: (fg: "#001608", bg: "#be8100", modifiers: "Bold"),
        inactive_style: (fg: "#8c5f00", bg: "#0d001d"),
    ),
    lyrics: (
        timestamp: false
    ),
    cava: (bar_color: Single("#32c978")),
    browser_song_format: [
        (
            kind: Group([
                (kind: Property(Track)),
                (kind: Text(" ")),
            ])
        ),
        (
            kind: Group([
                (kind: Property(Artist)),
                (kind: Text(" - ")),
                (kind: Property(Title)),
            ]),
            default: (kind: Property(Filename))
        ),
    ],
    show_song_table_header: true,
    song_table_format: [
        (
            prop: (kind: Property(Artist),
                default: (kind: Text("Unknown"))
            ),
            label_prop: (kind: Text("Artist")),
            width: "20%",
        ),
        (
            prop: (kind: Property(Title),
                default: (kind: Text("Unknown"))
            ),
            label_prop: (kind: Text("Title")),
            width: "35%",
        ),
        (
            prop: (kind: Property(Album), style: (fg: "#eaa000"),
                default: (kind: Text("Unknown Album"), style: (fg: "#eaa000"))
            ),
            label_prop: (kind: Text("Album")),
            width: "30%",
        ),
        (
            prop: (kind: Property(Duration),
                default: (kind: Text("-"))
            ),
            label_prop: (kind: Text("Duration")),
            width: "15%",
            alignment: Right,
        ),
    ],
    layout: Split(
        direction: Vertical,
        panes: [
            (
                size: "3",
                borders: "BOTTOM",
                pane: Component("np_header"),
            ),
            (
                size: "2",
                borders: "BOTTOM",
                pane: Pane(Tabs),
            ),
            (
                pane: Pane(TabContent),
                size: "100%",
            ),
            (
                size: "3",
                pane: Split(
                    direction: Horizontal,
                    panes: [
                        (
                            size: "12",
                            borders: "ALL",
                            border_symbols: Inherited(parent: Rounded, top_right: "┬", bottom_right: "┴"),
                            pane: Component("input_mode")
                        ),
                        (
                            size: "100%",
                            borders: "TOP | BOTTOM | RIGHT",
                            border_symbols: Rounded,
                            border_title: [(kind: Text(" ")), (kind: Property(Status(QueueLength()))), (kind: Text(" songs / ")), (kind: Property(Status(QueueTimeTotal()))), (kind: Text(" total time "))],
                            border_title_alignment: Right,
                            pane: Component("progress_bar"),
                        ),
                    ]
                ),
            ),
        ],
    ),
    components: {
        "state": Pane(Property(
            content: [
                (kind: Text("["), style: (fg: "#eaa000", modifiers: "Bold")),
                (kind: Property(Status(StateV2( ))), style: (fg: "#eaa000", modifiers: "Bold")),
                (kind: Text("]"), style: (fg: "#eaa000", modifiers: "Bold")),
            ], align: Left,
        )),
        "title": Pane(Property(
            content: [
                (kind: Property(Song(Title)), style: (modifiers: "Bold"),
                    default: (kind: Text("No Song"), style: (modifiers: "Bold"))),
            ], align: Center, scroll_speed: 1
        )),
        "volume": Split(
            direction: Horizontal,
            panes: [
                (size: "1", pane: Pane(Property(content: [(kind: Text(""))]))),
                (size: "100%", pane: Pane(Volume(kind: Slider(
                    symbols: (filled: "─", thumb: "●", track: "─"),
                    filled_style: (fg: "#32c978"), thumb_style: (fg: "#32c978"), track_style: (fg: "#8c5f00"),
                )))),
                (size: "3", pane: Pane(Property(content: [(kind: Property(Status(Volume)), style: (fg: "#32c978"))], align: Right))),
                (size: "2", pane: Pane(Property(content: [(kind: Text("%"), style: (fg: "#32c978"))]))),
            ]
        ),
        "elapsed": Pane(Property(
            content: [
                (kind: Property(Status(Elapsed))),
                (kind: Text(" / ")),
                (kind: Property(Status(Duration))),
            ],
            align: Left,
        )),
        "np_header": Split(
            direction: Horizontal,
            panes: [
                (
                    size: "26",
                    pane: Split(
                        direction: Vertical,
                        panes: [
                            (size: "1", pane: Component("state")),
                            (size: "1", pane: Component("elapsed")),
                        ]
                    )
                ),
                (
                    size: "100%",
                    pane: Split(
                        direction: Vertical,
                        panes: [
                            (size: "1", pane: Component("title")),
                            (size: "1", pane: Component("artist_and_album")),
                        ]
                    )
                ),
                (
                    size: "30",
                    pane: Split(
                        direction: Vertical,
                        panes: [
                            (size: "1", pane: Component("volume")),
                            (size: "1", pane: Component("states")),
                        ]
                    )
                ),
            ]
        ),
        "elapsed_and_bitrate": Pane(Property(
            content: [
                (kind: Property(Status(Elapsed))), 
                (kind: Text(" / ")), 
                (kind: Property(Status(Duration))), 
                (kind: Group([
                    (kind: Text(" (")), 
                    (kind: Property(Status(Bitrate))), 
                    (kind: Text(" kbps)")),
                ])),
            ],
            align: Left,
        )),
        "artist_and_album": Pane(Property(
            content: [
                (kind: Property(Song(Artist)), style: (fg: "#eaa000", modifiers: "Bold"),
                    default: (kind: Text("Unknown"), style: (fg: "#eaa000", modifiers: "Bold"))),
                (kind: Text(" - ")),
                (kind: Property(Song(Album)), default: (kind: Text("Unknown Album"))),
            ], align: Center, scroll_speed: 1
        )),
        "states": Split(
            direction: Horizontal,
            panes: [
                (
                    size: "1",
                    pane: Pane(Empty())
                ),
                (
                    size: "100%",
                    pane: Pane(Property(content: [(kind: Property(Status(InputBuffer())), style: (fg: "#8c5f00"), align: Left)]))
                ),
                (
                    size: "6",
                    pane: Pane(Property(content: [
                        (kind: Text("["), style: (fg: "#8c5f00", modifiers: "Bold")),
                        (kind: Property(Status(RepeatV2(
                            on_label: "z",
                            off_label: "z",
                            on_style: (fg: "#eaa000", modifiers: "Bold"),
                            off_style: (fg: "#8c5f00", modifiers: "Dim"),
                        )))),
                        (kind: Property(Status(RandomV2(
                            on_label: "x",
                            off_label: "x",
                            on_style: (fg: "#eaa000", modifiers: "Bold"),
                            off_style: (fg: "#8c5f00", modifiers: "Dim"),
                        )))),
                        (kind: Property(Status(ConsumeV2(
                            on_label: "c",
                            off_label: "c",
                            oneshot_label: "c",
                            on_style: (fg: "#eaa000", modifiers: "Bold"),
                            off_style: (fg: "#8c5f00", modifiers: "Dim"),
                            oneshot_style: (fg: "#32c978", modifiers: "Dim"),
                        )))),
                        (kind: Property(Status(SingleV2(
                            on_label: "v",
                            off_label: "v",
                            oneshot_label: "v",
                            on_style: (fg: "#eaa000", modifiers: "Bold"),
                            off_style: (fg: "#8c5f00", modifiers: "Dim"),
                            oneshot_style: (fg: "#32c978", modifiers: "Bold"),
                        )))),
                        (kind: Text("]"), style: (fg: "#8c5f00", modifiers: "Bold")),
                        ],
                        align: Right
                    ))
                ),
            ]
        ),
        "input_mode": Pane(Property(
            content: [
                (kind: Transform(Replace(content: (kind: Property(Status(InputMode()))), replacements: [
                    (match: "Normal", replace: (kind: Text(" NORMAL "), style: (fg: "#001608", bg: "#be8100"))),
                    (match: "Insert", replace: (kind: Text(" INSERT "), style: (fg: "#001608", bg: "#32c978"))),
                ])))
            ], align: Center
        )),
        "header_left": Split(
            direction: Vertical,
            panes: [
                (size: "1", pane: Component("state")),
                (size: "1", pane: Component("elapsed_and_bitrate")),
            ]
        ),
        "header_center": Split(
            direction: Vertical,
            panes: [
                (size: "1", pane: Component("title")),
                (size: "1", pane: Component("artist_and_album")),
            ]
        ),
        "header_right": Split(
            direction: Vertical,
            panes: [
                (size: "1", pane: Component("volume")),
                (size: "1", pane: Component("states")),
            ]
        ),
        "progress_bar": Split(
            direction: Horizontal,
            panes: [
                (
                    size: "1",
                    pane: Pane(Empty())
                ),
                (
                    size: "100%",
                    pane: Pane(ProgressBar)
                ),
                (
                    size: "1",
                    pane: Pane(Empty())
                ),
            ]
        )
    },
)
